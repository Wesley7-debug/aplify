# ── Database ────────────────────────────────────────────────────────────────
# Leave both blank to use the local SQLite file at data/aplify.db (default).
#
# To use Turso instead, set the database URL and an auth token created with:
#   turso db tokens create aplify
# The client uses Turso's HTTP transport, so no native build is required.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Example hosted database:
# TURSO_DATABASE_URL=libsql://aplify-slycodez.aws-us-east-1.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Optional: use a custom local file (default file:data/aplify.db).
# APLIFY_DB_URL=file:data/aplify.db

# ── Admin ───────────────────────────────────────────────────────────────────
# Required for /admin and /api/admin/*.
ADMIN_PASSWORD=change-me
# Optional separate signing key; defaults to ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=

# ── Overpass mirrors (optional) ─────────────────────────────────────────────
# Comma-separated. The crawler races these mirrors.
# APLIFY_OVERPASS_MIRRORS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
